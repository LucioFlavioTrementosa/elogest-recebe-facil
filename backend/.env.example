# Variáveis de ambiente aceitas pelo backend. Este arquivo NÃO é lido
# automaticamente: defina-as no ambiente do servidor (systemd, Docker,
# painel da hospedagem, ou `$env:NOME="valor"` no PowerShell).
# Nenhuma é obrigatória em desenvolvimento.

# Segredo dos tokens JWT. Em produção, defina um valor longo e aleatório.
# (Sem ele, um segredo é gerado e salvo em data/.jwt_secret.)
ELOGEST_JWT_SECRET=

# Onde fica o banco SQLite (padrão: backend/data/elogest.db)
ELOGEST_DB=

# Fuso usado para decidir se um débito está vencido
ELOGEST_TZ=America/Sao_Paulo

# Validade do login, em horas
ELOGEST_TOKEN_HORAS=8

# Só se o frontend for hospedado em OUTRO endereço (ex.: http://localhost:5500)
ELOGEST_CORS_ORIGINS=

# Tentativas de login antes de bloquear (por IP + usuário) e a janela em segundos
ELOGEST_LOGIN_MAX_TENTATIVAS=5
ELOGEST_LOGIN_JANELA_SEGUNDOS=900
